# Modelo do arquivo .env usado pelo docker-compose.yml no servidor.
# Copie para .env e troque a senha:  cp .env.example .env
# O .env de verdade nao vai para o git (esta no .gitignore).

# Senha do PostgreSQL. Defina antes do primeiro "docker compose up":
# o banco grava a senha na criacao do volume e nao muda depois.
DB_PASSWORD=troque-esta-senha
